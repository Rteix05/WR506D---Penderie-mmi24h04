# Adresse de l'API Symfony (dossier /api, lancé avec docker compose).
#
# localhost fonctionne pour la version web et le simulateur iOS. Sur un
# téléphone réel, « localhost » désigne le téléphone lui-même : créer un
# fichier .env.local (non commité) avec l'IP du poste sur le Wi-Fi, par ex.
#   EXPO_PUBLIC_API_URL=http://192.168.1.42:8080
# Émulateur Android : http://10.0.2.2:8080
#
# Variable publique (préfixe EXPO_PUBLIC_) : jamais de secret ici.
EXPO_PUBLIC_API_URL=http://localhost:8080
