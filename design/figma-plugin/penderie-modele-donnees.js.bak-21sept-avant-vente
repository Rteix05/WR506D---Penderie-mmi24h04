// ---------- GRILLE ----------
// Pas de colonne genereux : la gouttiere sert de couloir aux connecteurs.
const CARTE_W   = 300;
const GOUTTIERE = 130;
const PITCH     = CARTE_W + GOUTTIERE;   // 430
const MARGE_G   = 120;                   // marge interne du panneau
const BANDE_GAP = 190;                   // couloir horizontal entre domaines
const SUBROW_GAP = 90;                   // entre deux sous-rangees d'un domaine
const PANNEAU_PAD_H = 64;                // air sous le libelle du panneau
const PANNEAU_PAD_B = 56;

const solid = function (c, o) {
  if (!c || typeof c !== "object" || typeof c.r !== "number") {
    throw new Error("solid() attend une couleur RGB, recu : " + JSON.stringify(c));
  }
  return [{ type: "SOLID", color: c, opacity: o == null ? 1 : o }];
};
const SHADOW_E1 = {
  type: "DROP_SHADOW", color: { r: 0.10, g: 0.12, b: 0.14, a: 0.06 },
  offset: { x: 0, y: 1 }, radius: 3, spread: 0, visible: true, blendMode: "NORMAL"
};

let PAGE = null;

function frame(name, o) {
  o = o || {};
  const f = figma.createFrame();
  f.name = name;
  f.clipsContent = false;
  f.fills = o.fill ? solid(o.fill, o.fillOpacity) : [];
  if (o.radius != null) f.cornerRadius = o.radius;
  if (o.stroke) { f.strokes = solid(o.stroke, o.strokeOpacity); f.strokeWeight = o.strokeWeight || 1; }
  if (o.shadow) f.effects = [SHADOW_E1];
  if (o.dir) {
    f.layoutMode = o.dir;
    f.primaryAxisSizingMode = "AUTO";
    f.counterAxisSizingMode = "AUTO";
    f.itemSpacing = o.gap == null ? 0 : o.gap;
    f.paddingLeft = f.paddingRight = o.px == null ? 0 : o.px;
    f.paddingTop = f.paddingBottom = o.py == null ? 0 : o.py;
    if (o.align) f.counterAxisAlignItems = o.align;
  }
  return f;
}

function text(chars, o) {
  o = o || {};
  const t = figma.createText();
  t.fontName = o.font || FONT_L;
  t.characters = String(chars);
  t.fontSize = o.size || 12;
  t.fills = solid(o.color || C.ink, o.opacity);
  t.textAutoResize = "WIDTH_AND_HEIGHT";
  if (o.lineHeight) t.lineHeight = { value: o.lineHeight, unit: "PIXELS" };
  t.name = String(chars).slice(0, 28);
  return t;
}

function para(chars, largeur, o) {
  const t = text(chars, o);
  t.textAutoResize = "HEIGHT";
  t.resize(largeur, t.height);
  return t;
}

function pastille(label, couleur) {
  const p = frame("Pastille/" + label, {
    dir: "HORIZONTAL", px: 8, py: 3, radius: R.full,
    fill: couleur, fillOpacity: 0.12, align: "CENTER"
  });
  p.appendChild(text(label, { font: FONT_LB, size: 10, color: couleur }));
  return p;
}
const STATUTS = {
  MVP:     function () { return pastille("MVP", C.mainTexte); },
  VALIDER: function () { return pastille("À valider", C.primaryTexte); },
  V2:      function () { return pastille("V2", C.warn); },
  TECH:    function () { return pastille("Technique", C.sub); },
  NOUVEAU: function () { return pastille("Nouveau", C.cloth); }
};

// ---------- CONNECTEURS ----------
// Rectangles et pas vecteurs. Un trait = 1 rectangle de 1.5 px.
function segment(parent, x, y, w, h, couleur, opacite) {
  const r = figma.createRectangle();
  r.name = "Lien";
  r.x = Math.round(x); r.y = Math.round(y);
  r.resize(Math.max(Math.abs(w), 1.5), Math.max(Math.abs(h), 1.5));
  r.fills = solid(couleur || C.sub, opacite == null ? 0.5 : opacite);
  parent.appendChild(r);
  return r;
}

function pointe(parent, x, y, sens, couleur) {
  // Petit carre pivote : une fleche vectorielle serait fragile.
  const p = figma.createRectangle();
  p.name = "Pointe";
  p.resize(7, 7);
  p.x = Math.round(x - 3.5); p.y = Math.round(y - 3.5);
  p.rotation = 45;
  p.fills = solid(couleur || C.sub, 0.75);
  parent.appendChild(p);
  return p;
}

// ---------- CARTE D'ENTITE ----------
// e = { nom, statut, role, attrs: [[kind, nom, type]], rels: [ "..." ], accent }
function carteEntite(e) {
  const accent = e.accent === "primary" ? C.primary
               : e.accent === "cloth"   ? C.cloth
               : e.accent === "main"    ? C.main : null;

  const carte = frame("Entité/" + e.nom, {
    dir: "VERTICAL", gap: 9, px: 16, py: 14,
    fill: C.white, radius: R.md, shadow: true,
    stroke: accent || C.line, strokeWeight: accent ? 2 : 1
  });
  carte.resize(CARTE_W, carte.height);
  carte.counterAxisSizingMode = "FIXED";
  carte.primaryAxisSizingMode = "AUTO";

  // Bandeau titre
  const tete = frame("Entête", { dir: "HORIZONTAL", gap: 8, align: "CENTER" });
  tete.appendChild(text(e.nom, { font: FONT_LB, size: 15, color: accent || C.ink }));
  // statut = une clé, ou plusieurs séparées par "+" (ex. "MVP+NOUVEAU")
  if (e.statut) {
    const cles = String(e.statut).split("+").filter(function (k) { return STATUTS[k]; });
    if (cles.length) {
      const bloc = frame("Statuts", { dir: "HORIZONTAL", gap: 6, align: "CENTER" });
      cles.forEach(function (k) { bloc.appendChild(STATUTS[k]()); });
      tete.appendChild(bloc);
    }
  }
  carte.appendChild(tete);
  tete.layoutSizingHorizontal = "FILL";
  tete.primaryAxisAlignItems = "SPACE_BETWEEN";

  if (e.role) {
    const r = para(e.role, CARTE_W - 32, { size: 10.5, color: C.sub, lineHeight: 14 });
    carte.appendChild(r); r.layoutSizingHorizontal = "FILL";
  }

  // Attributs
  const f1 = frame("Filet", { fill: C.line });
  f1.resize(CARTE_W - 32, 1); carte.appendChild(f1); f1.layoutSizingHorizontal = "FILL";

  const liste = frame("Attributs", { dir: "VERTICAL", gap: 3 });
  for (let i = 0; i < e.attrs.length; i++) {
    const a = e.attrs[i];
    const coul = a[0] === "pk" ? C.mainTexte : (a[0] === "fk" ? C.cloth : C.ink);
    const l = frame("Attr", { dir: "HORIZONTAL", gap: 6, align: "CENTER" });
    l.appendChild(text(a[1], { font: FONT_LB, size: 11, color: coul }));
    if (a[2]) l.appendChild(text(a[2], { size: 10, color: C.sub }));
    liste.appendChild(l); l.layoutSizingHorizontal = "FILL";
  }
  carte.appendChild(liste); liste.layoutSizingHorizontal = "FILL";

  // Bloc RELATIONS
  if (e.rels && e.rels.length) {
    const f2 = frame("Filet", { fill: C.line });
    f2.resize(CARTE_W - 32, 1); carte.appendChild(f2); f2.layoutSizingHorizontal = "FILL";
    const bloc = frame("Relations", { dir: "VERTICAL", gap: 2 });
    bloc.appendChild(text("RELATIONS", { font: FONT_LB, size: 9, color: C.sub }));
    for (let i = 0; i < e.rels.length; i++) {
      const l = para(e.rels[i], CARTE_W - 32, { size: 10.5, color: C.ink, lineHeight: 14 });
      bloc.appendChild(l); l.layoutSizingHorizontal = "FILL";
    }
    carte.appendChild(bloc); bloc.layoutSizingHorizontal = "FILL";
  }

  if (e.note) {
    const n = para(e.note, CARTE_W - 32, { size: 10, color: accent || C.sub, lineHeight: 13 });
    carte.appendChild(n); n.layoutSizingHorizontal = "FILL";
  }

  return carte;
}

// ---------- DONNEES ----------
// ENT : chaque entite porte sa position [colonne, sous-rangee] DANS son domaine.
// Les colonnes sont choisies pour aligner verticalement ce qui se relie
// (Item sous Room, Payment sous Order, Garment au-dessus de ses referentiels).
const DOMAINES = [];
const ENT = {};

function dom(nom, couleur, entites) {
  DOMAINES.push({ nom: nom, couleur: couleur, entites: entites });
  for (let i = 0; i < entites.length; i++) ENT[entites[i].id] = entites[i];
}

