// ---------- MISE EN PAGE ----------
// Deux passes obligatoires : les hauteurs de carte ne sont connues
// qu'apres construction, donc on batit tout, on mesure, puis on place.
const CARTES = {};   // id -> node
const BOITES = {};   // id -> { x, y, w, h } absolus dans la grande frame

function placer(grandeFrame) {
  let y = TITRE_H;
  const panneaux = [];

  for (let d = 0; d < DOMAINES.length; d++) {
    const domaine = DOMAINES[d];
    const yPanneau = y;
    let yCourant = y + PANNEAU_PAD_H;
    let colMax = 0;

    // hauteur de chaque sous-rangee = la plus haute carte qu'elle contient
    const subs = {};
    for (let i = 0; i < domaine.entites.length; i++) {
      const e = domaine.entites[i];
      const c = CARTES[e.id];
      if (!subs[e.sub]) subs[e.sub] = 0;
      if (c.height > subs[e.sub]) subs[e.sub] = c.height;
      if (e.col > colMax) colMax = e.col;
    }

    const clefs = Object.keys(subs).map(Number).sort(function (a, b) { return a - b; });
    const yDeSub = {};
    for (let s = 0; s < clefs.length; s++) {
      yDeSub[clefs[s]] = yCourant;
      yCourant += subs[clefs[s]] + SUBROW_GAP;
    }
    yCourant -= SUBROW_GAP;

    for (let i = 0; i < domaine.entites.length; i++) {
      const e = domaine.entites[i];
      const c = CARTES[e.id];
      c.x = MARGE_G + e.col * PITCH;
      c.y = yDeSub[e.sub];
      BOITES[e.id] = { x: c.x, y: c.y, w: CARTE_W, h: c.height };
    }

    panneaux.push({
      nom: domaine.nom, couleur: domaine.couleur,
      x: MARGE_G - 44, y: yPanneau,
      w: (colMax + 1) * PITCH - GOUTTIERE + 88,
      h: (yCourant + PANNEAU_PAD_B) - yPanneau
    });

    y = yCourant + PANNEAU_PAD_B + BANDE_GAP;
  }
  return { panneaux: panneaux, hauteur: y };
}

function dessinerPanneau(parent, p) {
  const f = frame("Domaine/" + p.nom, {
    fill: p.couleur, fillOpacity: 0.045, radius: R.lg,
    stroke: p.couleur, strokeOpacity: 0.35, strokeWeight: 1.5
  });
  f.resize(p.w, p.h);
  parent.insertChild(0, f);
  f.x = p.x; f.y = p.y;

  const t = text(p.nom, { font: FONT_LB, size: 19, color: p.couleur });
  parent.insertChild(1, t);
  t.x = p.x + 28; t.y = p.y + 22;
  return f;
}

// ---------- TRACE DES LIENS ----------
// Routage orthogonal. Les gouttieres (130 px) et les couloirs entre
// domaines (190 px) servent de passage : un lien ne traverse donc pas
// une carte, sauf croisement inevitable de deux couloirs.
function tracerLien(parent, lien, index) {
  const a = BOITES[lien[0]], b = BOITES[lien[1]];
  if (!a || !b) { console.warn("Lien ignoré, entité inconnue : " + lien[0] + " → " + lien[1]); return false; }

  const card = lien[2];
  const style = lien[3] || "";
  const opac = style === "opt" ? 0.32 : (style === "herit" ? 0.55 : 0.5);
  const coul = style === "herit" ? C.cloth : C.sub;

  // decalage pour eviter que deux liens se superposent exactement
  const off = ((index % 7) - 3) * 13;

  const aCY = a.y + a.h / 2, bCY = b.y + b.h / 2;
  const memeBande = Math.abs(a.y - b.y) < 24;

  let lx, ly;   // point ou poser l'etiquette
  let px, py;   // point ou poser la pointe

  if (memeBande && a.x !== b.x) {
    // --- lien horizontal dans la gouttiere
    const gauche = a.x < b.x ? a : b;
    const droite = a.x < b.x ? b : a;
    const y = Math.min(gauche.y + gauche.h, droite.y + droite.h) - 34 + off;
    const x1 = gauche.x + gauche.w, x2 = droite.x;
    segment(parent, x1, y, x2 - x1, 1.5, coul, opac);
    lx = x1 + 12; ly = y - 17;
    px = (a.x < b.x) ? x2 : x1; py = y;
  } else {
    // --- lien vertical : on descend dans le couloir entre les bandes
    const haut = a.y < b.y ? a : b;
    const bas  = a.y < b.y ? b : a;
    const xh = haut.x + haut.w / 2 + off;
    const xb = bas.x + bas.w / 2 + off;
    const yh = haut.y + haut.h;
    const yb = bas.y;
    const yc = yh + Math.max(28, (yb - yh) / 2) + ((index % 5) - 2) * 11;

    segment(parent, xh, yh, 1.5, yc - yh, coul, opac);
    segment(parent, Math.min(xh, xb), yc, Math.abs(xb - xh), 1.5, coul, opac);
    segment(parent, xb, yc, 1.5, yb - yc, coul, opac);
    lx = Math.min(xh, xb) + Math.abs(xb - xh) / 2 - 12; ly = yc - 18;
    px = (a.y < b.y) ? xb : xh;
    py = (a.y < b.y) ? yb : yh;
  }

  pointe(parent, px, py, null, coul);

  if (card) {
    const e = text(card, { font: FONT_LB, size: 10, color: coul });
    parent.appendChild(e);
    e.x = Math.round(lx); e.y = Math.round(ly);
  }
  return true;
}

// ---------- CONSTRUCTION ----------
const TITRE_H = 300;

async function construire() {
  await figma.loadAllPagesAsync();
  await figma.loadFontAsync(FONT_T);
  await figma.loadFontAsync(FONT_L);
  await figma.loadFontAsync(FONT_LB);

  PAGE = figma.root.children.filter(function (p) { return p.name === PAGE_CIBLE; })[0];
  if (!PAGE) throw new Error("page « " + PAGE_CIBLE + " » introuvable");
  await PAGE.loadAsync();
  figma.currentPage = PAGE;

  // Supprime UNIQUEMENT la production precedente de ce script
  let supprimes = 0;
  const racine = PAGE.children.slice();
  for (let i = 0; i < racine.length; i++) {
    if (racine[i].getPluginData(TAG) === "1") { racine[i].remove(); supprimes++; }
  }

  // La grande frame
  const G = frame("MDD — PENDERIE — VUE GLOBALE", { fill: C.bg, radius: R.lg });
  G.clipsContent = false;
  PAGE.appendChild(G);
  G.x = 0; G.y = 0;
  G.setPluginData(TAG, "1");

  // 1. batir toutes les cartes
  let nb = 0;
  for (let d = 0; d < DOMAINES.length; d++) {
    for (let i = 0; i < DOMAINES[d].entites.length; i++) {
      const e = DOMAINES[d].entites[i];
      const c = carteEntite(e);
      G.appendChild(c);
      CARTES[e.id] = c;
      nb++;
    }
  }

  // 2. mesurer et placer
  const mise = placer(G);

  // 3. dimensionner la frame
  let largeur = 0;
  for (let i = 0; i < mise.panneaux.length; i++) {
    const p = mise.panneaux[i];
    if (p.x + p.w > largeur) largeur = p.x + p.w;
  }
  G.resize(largeur + MARGE_G, mise.hauteur + 80);

  // 4. les liens, INSERES SOUS les cartes
  let traces = 0;
  for (let i = 0; i < LIENS.length; i++) {
    const avant = G.children.length;
    if (tracerLien(G, LIENS[i], i)) traces++;
    // remonter les segments crees sous les cartes
    const crees = G.children.length - avant;
    for (let k = 0; k < crees; k++) {
      const n = G.children[G.children.length - 1];
      if (n.name === "Lien" || n.name === "Pointe") G.insertChild(0, n);
      else break;
    }
  }

  // 5. les panneaux, tout au fond
  for (let i = mise.panneaux.length - 1; i >= 0; i--) dessinerPanneau(G, mise.panneaux[i]);

  // 6. le bloc titre, par-dessus
  const entete = frame("Titre", { dir: "VERTICAL", gap: 12 });
  entete.appendChild(text("WR506D · PENDERIE", { font: FONT_LB, size: 15, color: C.primaryTexte }));
  entete.appendChild(text("Modèle de données — vue globale", { font: FONT_T, size: 64, color: C.ink }));
  entete.appendChild(para(
    "52 entités en 11 domaines, plus les 5 sous-types de Share, la table technique RefreshToken et les liaisons. Réponses client du 21 septembre intégrées : le dressing et ses suggestions passent en MVP, le prêt aussi. Nommage des entités en anglais, "
    + "libellés d'interface en français. Aucune migration Doctrine n'est lancée : ce schéma est la matière de la review.",
    1100, { size: 17, color: C.sub, lineHeight: 25 }));
  G.appendChild(entete);
  entete.x = MARGE_G; entete.y = 56;

  const leg = frame("Légende", { dir: "HORIZONTAL", gap: 14, align: "CENTER" });
  leg.appendChild(STATUTS.MVP());
  leg.appendChild(STATUTS.VALIDER());
  leg.appendChild(STATUTS.V2());
  leg.appendChild(STATUTS.NOUVEAU());
  leg.appendChild(text("clé primaire", { font: FONT_LB, size: 11, color: C.mainTexte }));
  leg.appendChild(text("clé étrangère", { font: FONT_LB, size: 11, color: C.cloth }));
  leg.appendChild(text("— — —  relation nullable", { size: 11, color: C.sub }));
  leg.appendChild(text("violet = héritage", { size: 11, color: C.cloth }));
  G.appendChild(leg);
  leg.x = MARGE_G; leg.y = 56 + entete.height + 22;

  figma.viewport.scrollAndZoomIntoView([G]);

  console.log("=== MDD — VUE GLOBALE ===");
  console.log("Supprimés     : " + supprimes + " nœud(s) de la production précédente");
  console.log("Domaines      : " + DOMAINES.length);
  console.log("Entités       : " + nb);
  console.log("Liens tracés  : " + traces + " / " + LIENS.length);
  console.log("Frame         : " + Math.round(G.width) + " × " + Math.round(G.height) + " px");
}

construire().catch(function (e) {
  console.error("ECHEC : " + e.message);
  console.error(e.stack || "");
});
