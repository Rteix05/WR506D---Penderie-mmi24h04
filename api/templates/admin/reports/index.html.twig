{% extends 'admin/base.html.twig' %}
{% import 'admin/_ui.html.twig' as ui %}

{% block title %}{{ 'reports.pageTitle'|trans({}, 'admin') }}{% endblock %}
{% block active %}reports{% endblock %}
{% block heading %}{{ 'reports.heading'|trans({}, 'admin') }}{% endblock %}
{% block subtitle %}{{ 'reports.subtitle'|trans({count: pending|reduce((sum, n) => sum + n, 0)}, 'admin') }}{% endblock %}

{% block body %}
    {% set report_reasons = admin_labels('report_reasons') %}
    {% set report_types = admin_labels('report_types') %}
    {% set report_status = admin_labels('report_status') %}

    {# Trois onglets (rail gris, onglet plein), comme la maquette. #}
    <nav aria-label="{{ 'reports.filterAria'|trans({}, 'admin') }}" class="mb-4 flex rounded-full bg-ink/[0.05] p-1">
        {% for key, label in {
            objects: 'reports.tabObjects'|trans({count: pending['objects']}, 'admin'),
            contents: 'reports.tabContents'|trans({count: pending['contents']}, 'admin'),
            comments: 'reports.tabComments'|trans({count: pending['comments']}, 'admin'),
        } %}
            <a href="{{ path('admin_reports', {group: key, filter: state}) }}" {% if key == group %}aria-current="page"{% endif %}
               class="flex h-10 flex-1 items-center justify-center rounded-full text-legend font-bold {{ key == group ? 'bg-surface text-ink shadow-[0_1px_3px_rgba(26,30,36,0.12)]' : 'text-muted hover:text-ink' }}">{{ label }}</a>
        {% endfor %}
    </nav>

    {{ ui.tabs([
        {key: 'open', label: 'reports.tabsToTreat'|trans({}, 'admin')},
        {key: 'review', label: 'reports.tabsInProgress'|trans({}, 'admin')},
        {key: 'handled', label: 'reports.tabsHandled'|trans({}, 'admin')},
    ], state, 'admin_reports', {group: group}) }}

    <section class="{{ ui.card_class() }}" aria-label="{{ 'reports.sectionAria'|trans({}, 'admin') }}">
        {% if rows is empty %}
            <p class="text-body text-muted">{{ 'reports.empty'|trans({}, 'admin') }}</p>
        {% else %}
            <div class="overflow-x-auto">
                <table class="w-full min-w-[820px] text-left">
                    <thead><tr class="text-legend font-bold text-muted">
                        <th scope="col" class="pb-3">{{ 'reports.thElement'|trans({}, 'admin') }}</th><th scope="col" class="pb-3">{{ 'reports.thAuthor'|trans({}, 'admin') }}</th><th scope="col" class="pb-3">{{ 'reports.thReportedBy'|trans({}, 'admin') }}</th>
                        <th scope="col" class="pb-3">{{ 'reports.thReason'|trans({}, 'admin') }}</th><th scope="col" class="pb-3">{{ 'reports.thDate'|trans({}, 'admin') }}</th><th scope="col" class="pb-3">{{ 'reports.thStatus'|trans({}, 'admin') }}</th>
                        <th scope="col" class="pb-3"><span class="sr-only">{{ 'reports.thDetailSrOnly'|trans({}, 'admin') }}</span></th>
                    </tr></thead>
                    <tbody>
                    {% for row in rows %}
                        {% set r = row.report %}
                        {% set st = report_status[r.status.value] %}
                        <tr class="border-t border-ink/8 text-legend">
                            <td class="max-w-72 py-3">
                                <p class="truncate text-body font-bold">{{ r.targetType.value == 'COMMENT' ? 'reports.labelCommentPrefix'|trans({}, 'admin') ~ row.label ~ 'reports.labelCommentSuffix'|trans({}, 'admin') : row.label }}</p>
                                <p class="text-muted">{{ report_types[r.targetType.value] }}</p>
                            </td>
                            <td class="py-3">{{ row.author ? '@' ~ row.author.username : 'reports.authorUnknown'|trans({}, 'admin') }}</td>
                            <td class="py-3">{{ r.reporter.displayName }}</td>
                            <td class="py-3">{{ report_reasons[r.reason.value] }}</td>
                            <td class="py-3">{{ r.createdAt|admin_date }}</td>
                            <td class="py-3">{{ ui.pill(st[0], st[1]) }}</td>
                            <td class="py-3 text-right"><a class="font-bold text-primary hover:underline" href="{{ path('admin_report', {id: r.id}) }}">{{ 'reports.linkReview'|trans({}, 'admin') }}<span class="sr-only">{{ 'reports.linkReviewSrOnly'|trans({label: row.label}, 'admin') }}</span> ›</a></td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {{ ui.pager(page, perPage, total, 'admin_reports', {group: group, filter: state}, 'reports.pagerNote'|trans({}, 'admin')) }}
        {% endif %}
    </section>
{% endblock %}
