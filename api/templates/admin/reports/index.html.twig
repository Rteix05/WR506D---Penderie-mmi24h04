{% extends 'admin/base.html.twig' %}
{% import 'admin/_ui.html.twig' as ui %}

{% block title %}Signalements{% endblock %}
{% block active %}reports{% endblock %}
{% block heading %}Signalements{% endblock %}
{% block subtitle %}{{ pending|reduce((sum, n) => sum + n, 0) }} à traiter · objets, contenus et commentaires{% endblock %}

{% block body %}
    {% set report_reasons = admin_labels('report_reasons') %}
    {% set report_types = admin_labels('report_types') %}
    {% set report_status = admin_labels('report_status') %}

    {# Trois onglets (rail gris, onglet plein), comme la maquette. #}
    <nav aria-label="Type de contenu" class="mb-4 flex rounded-full bg-ink/[0.05] p-1">
        {% for key, label in {objects: 'Objets', contents: 'Contenus', comments: 'Commentaires'} %}
            <a href="{{ path('admin_reports', {group: key, filter: state}) }}" {% if key == group %}aria-current="page"{% endif %}
               class="flex h-10 flex-1 items-center justify-center rounded-full text-legend font-bold {{ key == group ? 'bg-surface text-ink shadow-[0_1px_3px_rgba(26,30,36,0.12)]' : 'text-muted hover:text-ink' }}">{{ label }} ({{ pending[key] }})</a>
        {% endfor %}
    </nav>

    {{ ui.tabs([
        {key: 'open', label: 'À traiter'},
        {key: 'review', label: 'En cours'},
        {key: 'handled', label: 'Traités'},
    ], state, 'admin_reports', {group: group}) }}

    <section class="{{ ui.card_class() }}" aria-label="Signalements">
        {% if rows is empty %}
            <p class="text-body text-muted">Rien ici.</p>
        {% else %}
            <div class="overflow-x-auto">
                <table class="w-full min-w-[820px] text-left">
                    <thead><tr class="text-legend font-bold text-muted">
                        <th scope="col" class="pb-3">Élément</th><th scope="col" class="pb-3">Auteur</th><th scope="col" class="pb-3">Signalé par</th>
                        <th scope="col" class="pb-3">Motif</th><th scope="col" class="pb-3">Date</th><th scope="col" class="pb-3">Statut</th>
                        <th scope="col" class="pb-3"><span class="sr-only">Détail</span></th>
                    </tr></thead>
                    <tbody>
                    {% for row in rows %}
                        {% set r = row.report %}
                        {% set st = report_status[r.status.value] %}
                        <tr class="border-t border-ink/8 text-legend">
                            <td class="max-w-72 py-3">
                                <p class="truncate text-body font-bold">{{ r.targetType.value == 'COMMENT' ? '« ' ~ row.label ~ ' »' : row.label }}</p>
                                <p class="text-muted">{{ report_types[r.targetType.value] }}</p>
                            </td>
                            <td class="py-3">{{ row.author ? '@' ~ row.author.username : '—' }}</td>
                            <td class="py-3">{{ r.reporter.displayName }}</td>
                            <td class="py-3">{{ report_reasons[r.reason.value] }}</td>
                            <td class="py-3">{{ r.createdAt|admin_date }}</td>
                            <td class="py-3">{{ ui.pill(st[0], st[1]) }}</td>
                            <td class="py-3 text-right"><a class="font-bold text-primary hover:underline" href="{{ path('admin_report', {id: r.id}) }}">Examiner<span class="sr-only"> le signalement de {{ row.label }}</span> ›</a></td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {{ ui.pager(page, perPage, total, 'admin_reports', {group: group, filter: state}, 'un contenu n’est signalé que par quelqu’un qui le voit') }}
        {% endif %}
    </section>
{% endblock %}
