{% extends 'admin/base.html.twig' %}
{% import 'admin/_ui.html.twig' as ui %}

{% block title %}{{ 'users.pageTitle'|trans({}, 'admin') }}{% endblock %}
{% block active %}users{% endblock %}
{% block heading %}{{ 'users.heading'|trans({}, 'admin') }}{% endblock %}
{% block subtitle %}{{ 'users.subtitle'|trans({all: counts.all|number_format(0, ',', ' '), children: counts.children|number_format(0, ',', ' ')}, 'admin') }}{% endblock %}
{% block search %}{{ ui.search('users.searchPlaceholder'|trans({}, 'admin'), query, {filter: filter}) }}{% endblock %}

{% block body %}
    {{ ui.tabs([
        {key: 'all', label: 'users.tabs.all'|trans({}, 'admin')},
        {key: 'active', label: 'users.tabs.active'|trans({}, 'admin')},
        {key: 'suspended', label: 'users.tabs.suspended'|trans({count: counts.suspended}, 'admin')},
        {key: 'children', label: 'users.tabs.withChildProfile'|trans({}, 'admin')},
    ], filter, 'admin_users', {q: query}) }}

    <section class="{{ ui.card_class() }}" aria-label="{{ 'users.aria.accounts'|trans({}, 'admin') }}">
        {% if rows is empty %}
            <p class="text-body text-muted">{{ query ? 'users.empty.search'|trans({query: query}, 'admin') : 'users.empty.none'|trans({}, 'admin') }}</p>
        {% else %}
            <div class="overflow-x-auto">
                <table class="w-full min-w-[720px] text-left">
                    <thead>
                    <tr class="text-legend font-bold text-muted">
                        <th scope="col" class="pb-3">{{ 'users.table.user'|trans({}, 'admin') }}</th>
                        <th scope="col" class="pb-3">{{ 'users.table.profiles'|trans({}, 'admin') }}</th>
                        <th scope="col" class="pb-3">{{ 'users.table.registeredAt'|trans({}, 'admin') }}</th>
                        <th scope="col" class="pb-3">{{ 'users.table.items'|trans({}, 'admin') }}</th>
                        <th scope="col" class="pb-3">{{ 'users.table.status'|trans({}, 'admin') }}</th>
                        <th scope="col" class="pb-3"><span class="sr-only">{{ 'users.table.sheet'|trans({}, 'admin') }}</span></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for row in rows %}
                        <tr class="border-t border-ink/8 text-legend">
                            <td class="py-3">
                                <p class="text-body font-bold">{{ row.profile ? row.profile.displayName : row.account.email }}</p>
                                <p class="text-muted">{{ row.account.email }}</p>
                            </td>
                            <td class="py-3">{{ row.profiles }}{% if row.children %} · {{ 'users.childrenCount'|trans({count: row.children}, 'admin') }}{% endif %}</td>
                            <td class="py-3">{{ row.account.createdAt|admin_date }}</td>
                            <td class="py-3">{{ row.possessions }}</td>
                            <td class="py-3">{{ row.suspended ? ui.pill('users.status.suspended'|trans({}, 'admin'), 'red') : ui.pill('users.status.active'|trans({}, 'admin'), 'green') }}</td>
                            <td class="py-3 text-right">
                                <a class="font-bold text-primary hover:underline" href="{{ path('admin_user', {id: row.account.id}) }}">{{ 'users.view'|trans({}, 'admin') }}<span class="sr-only"> {{ 'users.viewSheetOf'|trans({email: row.account.email}, 'admin') }}</span> ›</a>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {{ ui.pager(page, perPage, total, 'admin_users', {filter: filter, q: query}) }}
        {% endif %}
    </section>
{% endblock %}
