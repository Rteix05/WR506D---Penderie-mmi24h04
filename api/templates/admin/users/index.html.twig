{% extends 'admin/base.html.twig' %}
{% import 'admin/_ui.html.twig' as ui %}

{% block title %}Utilisateurs{% endblock %}
{% block active %}users{% endblock %}
{% block heading %}Utilisateurs{% endblock %}
{% block subtitle %}{{ counts.all|number_format(0, ',', ' ') }} comptes · {{ counts.children|number_format(0, ',', ' ') }} avec un profil enfant{% endblock %}
{% block search %}{{ ui.search('Nom, e-mail, identifiant…', query, {filter: filter}) }}{% endblock %}

{% block body %}
    {{ ui.tabs([
        {key: 'all', label: 'Tous'},
        {key: 'active', label: 'Actifs'},
        {key: 'suspended', label: 'Suspendus (' ~ counts.suspended ~ ')'},
        {key: 'children', label: 'Avec profil enfant'},
    ], filter, 'admin_users', {q: query}) }}

    <section class="{{ ui.card_class() }}" aria-label="Comptes">
        {% if rows is empty %}
            <p class="text-body text-muted">{{ query ? 'Aucun compte ne correspond à « ' ~ query ~ ' ».' : 'Aucun compte ici.' }}</p>
        {% else %}
            <div class="overflow-x-auto">
                <table class="w-full min-w-[720px] text-left">
                    <thead>
                    <tr class="text-legend font-bold text-muted">
                        <th scope="col" class="pb-3">Utilisateur</th>
                        <th scope="col" class="pb-3">Profils</th>
                        <th scope="col" class="pb-3">Inscrit le</th>
                        <th scope="col" class="pb-3">Objets</th>
                        <th scope="col" class="pb-3">Statut</th>
                        <th scope="col" class="pb-3"><span class="sr-only">Fiche</span></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for row in rows %}
                        <tr class="border-t border-ink/8 text-legend">
                            <td class="py-3">
                                <p class="text-body font-bold">{{ row.profile ? row.profile.displayName : row.account.email }}</p>
                                <p class="text-muted">{{ row.account.email }}</p>
                            </td>
                            <td class="py-3">{{ row.profiles }}{% if row.children %} · dont {{ row.children }} {{ row.children > 1 ? 'enfants' : 'enfant' }}{% endif %}</td>
                            <td class="py-3">{{ row.account.createdAt|admin_date }}</td>
                            <td class="py-3">{{ row.possessions }}</td>
                            <td class="py-3">{{ row.suspended ? ui.pill('Suspendu', 'red') : ui.pill('Actif', 'green') }}</td>
                            <td class="py-3 text-right">
                                <a class="font-bold text-primary hover:underline" href="{{ path('admin_user', {id: row.account.id}) }}">Voir<span class="sr-only"> la fiche de {{ row.account.email }}</span> ›</a>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {{ ui.pager(page, perPage, total, 'admin_users', {filter: filter, q: query}) }}
        {% endif %}
    </section>
{% endblock %}
