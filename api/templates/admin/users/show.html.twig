{% extends 'admin/base.html.twig' %}
{% import 'admin/_ui.html.twig' as ui %}

{% set name = profile ? profile.displayName : account.email %}
{% block title %}{{ name }}{% endblock %}
{% block active %}users{% endblock %}
{% block heading %}{{ name }}{% endblock %}
{% block subtitle %}<a class="hover:underline" href="{{ path('admin_users') }}">Utilisateurs</a> › {{ name }}{% endblock %}

{% block body %}
    {% set types = {ADULT: 'Adulte', CHILD: 'Enfant', RELATIVE: 'Proche'} %}
    {% set actions = {BAN_ACCOUNT: 'Compte suspendu', RESTORE: 'Compte réactivé', SUSPEND_PROFILE: 'Profil suspendu', WARN: 'Avertissement', HIDE_CONTENT: 'Contenu masqué', DELETE_CONTENT: 'Contenu supprimé'} %}

    <div class="grid gap-6 xl:grid-cols-[minmax(0,360px)_1fr]">
        <div class="flex flex-col gap-6">
            <section class="{{ ui.card_class() }}" aria-label="Compte">
                <p class="text-body font-bold">{{ name }}</p>
                <p class="text-legend text-muted">{% if profile %}@{{ profile.username }} · {% endif %}{{ account.email }}</p>
                <dl class="mt-4 flex flex-col gap-2 text-legend">
                    <div class="flex justify-between gap-4"><dt class="text-muted">Inscrit le</dt><dd class="text-body font-bold">{{ account.createdAt|admin_date }}</dd></div>
                    <div class="flex justify-between gap-4"><dt class="text-muted">Statut</dt><dd>{{ suspended ? ui.pill('Suspendu', 'red') : ui.pill('Actif', 'green') }}</dd></div>
                    {% if account.admin %}<div class="flex justify-between gap-4"><dt class="text-muted">Rôle</dt><dd>{{ ui.pill('Administrateur', 'pink') }}</dd></div>{% endif %}
                </dl>
            </section>

            <section class="{{ ui.card_class() }}" aria-labelledby="activite">
                <h2 id="activite" class="text-legend font-bold text-muted">Activité</h2>
                <dl class="mt-3 flex flex-col gap-2 text-legend">
                    <div class="flex justify-between gap-4"><dt class="text-muted">Objets et vêtements</dt><dd class="text-body font-bold">{{ possessions }}</dd></div>
                    <div class="flex justify-between gap-4"><dt class="text-muted">Ventes · achats</dt><dd class="text-body font-bold">{{ sales }} · {{ purchases }}</dd></div>
                    <div class="flex justify-between gap-4"><dt class="text-muted">Litiges</dt><dd class="text-body font-bold">{{ disputes }}</dd></div>
                </dl>
            </section>

                <section class="{{ ui.card_class() }}" aria-labelledby="actions" data-controller="dialog">
                    <h2 id="actions" class="text-legend font-bold text-muted">Actions</h2>
                    {% if account.id == app.user.id %}
                        <p class="mt-3 text-legend text-muted">C’est ton propre compte : il ne se suspend pas d’ici.</p>
                    {% else %}
                        <button type="button" class="mt-3 {{ ui.button_class(suspended ? 'primary' : 'danger') }}" data-action="dialog#open">
                            {{ suspended ? 'Réactiver le compte' : 'Suspendre le compte' }}
                        </button>
                        <dialog data-dialog-target="dialog" data-action="click->dialog#backdrop" aria-labelledby="confirmation"
                                class="m-auto w-[min(92vw,30rem)] rounded-lg bg-surface p-6 text-ink backdrop:bg-ink/55">
                            <form method="post" action="{{ path(suspended ? 'admin_user_reinstate' : 'admin_user_suspend', {id: account.id}) }}" class="flex flex-col gap-4">
                                <h2 id="confirmation" class="font-typolio text-h4 uppercase">{{ suspended ? 'Réactiver' : 'Suspendre' }} le compte de {{ profile ? '@' ~ profile.username : account.email }} ?</h2>
                                <p class="text-legend">
                                    {% if suspended %}
                                        Ses profils retrouvent l’accès à l’application.
                                    {% else %}
                                        {{ profiles|length > 1 ? 'Ses ' ~ profiles|length ~ ' profils ne pourront' : 'Son profil ne pourra' }} plus utiliser l’application tant que le compte n’est pas réactivé. Ses objets, ses prêts et ses ventes restent en place.
                                    {% endif %}
                                </p>
                                <label class="flex flex-col gap-1">
                                    <span class="text-legend font-bold text-muted">Motif (gardé dans le journal)</span>
                                    <textarea name="reason" required maxlength="500" rows="3" class="rounded-sm bg-bg px-4 py-3 text-body outline-none focus:ring-2 focus:ring-primary"></textarea>
                                </label>
                                <p class="rounded-sm bg-ink/[0.04] px-3 py-2 text-legend text-muted">Réversible depuis cette fiche. L’action est enregistrée à ton nom.</p>
                                <input type="hidden" name="_token" value="{{ csrf_token('moderate-' ~ account.id) }}">
                                <div class="flex justify-end gap-3">
                                    <button type="button" class="rounded-md px-4 py-2 text-body font-bold hover:bg-bg" data-action="dialog#close">Annuler</button>
                                    <button type="submit" class="rounded-md px-4 py-2 text-body font-bold text-white {{ suspended ? 'bg-primary' : 'bg-error' }}">{{ suspended ? 'Réactiver' : 'Suspendre' }}</button>
                                </div>
                            </form>
                        </dialog>
                    {% endif %}
                </section>
        </div>

        <div class="flex flex-col gap-6">
            <section class="{{ ui.card_class() }}" aria-label="Profils">
                <div class="overflow-x-auto">
                    <table class="w-full min-w-[520px] text-left">
                        <thead>
                        <tr class="text-legend font-bold text-muted">
                            <th scope="col" class="pb-3">Profil</th>
                            <th scope="col" class="pb-3">Type</th>
                            <th scope="col" class="pb-3">Objets</th>
                            <th scope="col" class="pb-3">Contrôle parental</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for row in profiles %}
                            {% set p = row.profile %}
                            <tr class="border-t border-ink/8 text-legend">
                                <td class="py-3">
                                    <p class="text-body font-bold">{{ p.displayName }}</p>
                                    <p class="text-muted">@{{ p.username }}{% if p.default %} · principal{% endif %}{% if p.child %} · {{ p.age }} ans{% endif %}</p>
                                </td>
                                <td class="py-3">{{ p.child ? ui.pill('Enfant', 'pink') : types[p.type.value] }}{% if p.suspendedAt %} {{ ui.pill('Suspendu', 'red') }}{% endif %}</td>
                                <td class="py-3">{{ row.possessions }}</td>
                                <td class="py-3">{{ p.guardian ? 'Tuteur : ' ~ p.guardian.displayName : '—' }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="{{ ui.card_class() }}" aria-labelledby="journal">
                <h2 id="journal" class="text-legend font-bold text-muted">Journal d’administration</h2>
                {% if history is empty %}
                    <p class="mt-3 flex items-start gap-3 text-legend"><span class="mt-1 size-2 shrink-0 rounded-full bg-main" aria-hidden="true"></span><span><span class="text-body font-bold">Aucune sanction</span><br><span class="text-muted">Ce compte n’a jamais été suspendu.</span></span></p>
                {% else %}
                    <ol class="mt-3 flex flex-col gap-3">
                        {% for action in history %}
                            <li class="flex items-start gap-3 text-legend">
                                <span class="mt-1 size-2 shrink-0 rounded-full {{ action.actionType.value == 'RESTORE' ? 'bg-main' : 'bg-error' }}" aria-hidden="true"></span>
                                <span>
                                    <span class="text-body font-bold">{{ actions[action.actionType.value] ?? action.actionType.value }}</span>
                                    <span class="text-muted">{{ action.createdAt|admin_date(true) }} · par {{ action.admin.email }}</span><br>
                                    « {{ action.reason }} »
                                </span>
                            </li>
                        {% endfor %}
                    </ol>
                {% endif %}
            </section>
        </div>
    </div>
{% endblock %}
