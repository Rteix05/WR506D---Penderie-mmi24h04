{#
 # Connexion au back-office (maquette « Admin — Connexion ») : carte blanche
 # sur fond encre. Le formulaire est traité par le pare-feu « admin »
 # (form_login, jeton CSRF « authenticate »).
 #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>Connexion · Back-office · Penderie</title>
    {{ importmap('app') }}
</head>
<body class="grid min-h-screen place-items-center bg-ink px-5 py-10">
<main class="w-full max-w-sm rounded-lg bg-surface p-8">
    <p class="flex items-center gap-2 font-typolio text-[20px]">PENDERIE <span class="rounded-full bg-primary px-2 py-0.5 font-luciole text-legend font-bold text-white">ADMIN</span></p>
    <h1 class="mt-6 font-typolio text-h4 uppercase">Back-office</h1>
    <p class="mt-1 text-legend text-muted">Réservé aux administrateurs. Cet espace n’existe pas dans l’application.</p>

    {% if error %}
        <p role="alert" class="mt-6 rounded-sm bg-error/10 px-4 py-3 text-legend font-bold text-error">
            {# Messages de Symfony en anglais (pas de composant de traduction) ; celui d'AdminUserChecker est déjà en français. #}
            {% set messages = {
                'Invalid credentials.': 'E-mail ou mot de passe incorrect.',
                'Invalid CSRF token.': 'La page a expiré : recharge-la et réessaie.',
            } %}
            {{ messages[error.messageKey] ?? error.messageKey|replace(error.messageData) }}
        </p>
    {% endif %}

    <form method="post" action="{{ path('admin_login') }}" class="mt-6 flex flex-col gap-5">
        <label class="flex flex-col gap-1">
            <span class="text-legend font-bold text-muted">E-mail professionnel</span>
            <input type="email" name="email" value="{{ email }}" required autofocus autocomplete="username"
                   class="h-12 rounded-sm bg-surface px-4 text-body shadow-[0_1px_3px_rgba(26,30,36,0.12)] outline-none focus:ring-2 focus:ring-primary">
        </label>
        <label class="flex flex-col gap-1">
            <span class="text-legend font-bold text-muted">Mot de passe</span>
            <input type="password" name="password" required autocomplete="current-password"
                   class="h-12 rounded-sm bg-surface px-4 text-body shadow-[0_1px_3px_rgba(26,30,36,0.12)] outline-none focus:ring-2 focus:ring-primary">
        </label>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button type="submit" class="h-12 rounded-md bg-primary text-body font-bold text-white hover:brightness-110 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2">Se connecter</button>
    </form>

    <p class="mt-6 text-center text-legend text-muted">Chaque action est enregistrée dans le journal.</p>
</main>
</body>
</html>
