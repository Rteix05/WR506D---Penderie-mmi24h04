{#
 # Connexion au back-office (maquette « Admin — Connexion ») : carte blanche
 # sur fond encre. Le formulaire est traité par le pare-feu « admin »
 # (form_login, jeton CSRF « authenticate »).
 #}
<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ 'login.pageTitle'|trans({}, 'admin') }}</title>
    {{ importmap('app') }}
</head>
<body class="grid min-h-screen place-items-center bg-ink px-5 py-10">
<main class="w-full max-w-sm rounded-lg bg-surface p-8">
    <p class="flex items-center gap-2 font-typolio text-[20px]">PENDERIE <span class="rounded-full bg-primary px-2 py-0.5 font-luciole text-legend font-bold text-white">ADMIN</span></p>
    <h1 class="mt-6 font-typolio text-h4 uppercase">{{ 'login.title'|trans({}, 'admin') }}</h1>
    <p class="mt-1 text-legend text-muted">{{ 'login.legend'|trans({}, 'admin') }}</p>

    {% if error %}
        <p role="alert" class="mt-6 rounded-sm bg-error/10 px-4 py-3 text-legend font-bold text-error">
            {# Les messages de Symfony (« Invalid credentials. »…) et celui d'AdminUserChecker sont des clés du domaine admin. #}
            {{ error.messageKey|trans(error.messageData, 'admin') }}
        </p>
    {% endif %}

    <form method="post" action="{{ path('admin_login') }}" class="mt-6 flex flex-col gap-5">
        <label class="flex flex-col gap-1">
            <span class="text-legend font-bold text-muted">{{ 'login.email'|trans({}, 'admin') }}</span>
            <input type="email" name="email" value="{{ email }}" required autofocus autocomplete="username"
                   class="h-12 rounded-sm bg-surface px-4 text-body shadow-[0_1px_3px_rgba(26,30,36,0.12)] outline-none focus:ring-2 focus:ring-primary">
        </label>
        <label class="flex flex-col gap-1">
            <span class="text-legend font-bold text-muted">{{ 'login.password'|trans({}, 'admin') }}</span>
            <input type="password" name="password" required autocomplete="current-password"
                   class="h-12 rounded-sm bg-surface px-4 text-body shadow-[0_1px_3px_rgba(26,30,36,0.12)] outline-none focus:ring-2 focus:ring-primary">
        </label>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button type="submit" class="h-12 rounded-md bg-primary text-body font-bold text-white hover:brightness-110 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2">{{ 'login.submit'|trans({}, 'admin') }}</button>
    </form>

    <p class="mt-6 text-center text-legend text-muted">{{ 'login.journal'|trans({}, 'admin') }}</p>
</main>
</body>
</html>
