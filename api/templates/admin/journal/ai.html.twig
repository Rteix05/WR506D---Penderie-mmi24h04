{% extends 'admin/base.html.twig' %}
{% import 'admin/_ui.html.twig' as ui %}

{% block title %}{{ 'journal.ai.title'|trans({}, 'admin') }}{% endblock %}
{% block active %}journal{% endblock %}
{% block heading %}{{ 'journal.heading'|trans({}, 'admin') }}{% endblock %}
{% block subtitle %}{{ 'journal.ai.subtitle'|trans({threshold: threshold}, 'admin') }}{% endblock %}

{% block body %}
    {% set ms = 'journal.ms' %}
    {% set statusPills = {
        FAILED: ['ai.status.failed'|trans({}, 'admin'), 'red'],
        APPLIED: ['ai.status.applied'|trans({}, 'admin'), 'pink'],
        PROPOSED: ['ai.status.proposed'|trans({}, 'admin'), 'pink'],
        CONFIRMED: ['ai.status.confirmed'|trans({}, 'admin'), 'green'],
        OVERRIDDEN: ['ai.status.overridden'|trans({}, 'admin'), 'grey'],
        REVERTED: ['ai.status.reverted'|trans({}, 'admin'), 'red'],
    } %}
    {% set verdicts = {
        DISMISS: 'ai.verdict.dismiss'|trans({}, 'admin'), WARN: 'ai.verdict.warn'|trans({}, 'admin'), SANCTION: 'ai.verdict.sanction'|trans({}, 'admin'), UNSURE: 'ai.verdict.unsure'|trans({}, 'admin'),
        BUYER: 'ai.verdict.buyer'|trans({}, 'admin'), SELLER: 'ai.verdict.seller'|trans({}, 'admin'), NONE: 'ai.verdict.none'|trans({}, 'admin'),
    } %}

    {{ include('admin/journal/_tabs.html.twig', {current: 'ai'}) }}

    {# Les 30 derniers jours. L'accord avec les administrateurs est le vrai taux de réussite de l'IA. #}
    <div class="mb-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        {{ ui.kpi('journal.ai.kpiTotal'|trans({}, 'admin'), stats.total, stats.failed ? 'journal.ai.kpiFailed'|trans({count: stats.failed}, 'admin') : null, 'red') }}
        {{ ui.kpi('journal.ai.kpiApplied'|trans({}, 'admin'), stats.applied + stats.reverted, stats.reverted ? 'journal.ai.kpiReverted'|trans({count: stats.reverted}, 'admin') : null, 'red') }}
        {{ ui.kpi('journal.ai.kpiProposed'|trans({}, 'admin'), stats.proposed, null, 'grey') }}
        {{ ui.kpi('journal.ai.kpiAgreement'|trans({}, 'admin'), stats.agreement is not null ? stats.agreement ~ ' %' : '—', stats.avgMs is not null ? 'journal.ai.kpiAvg'|trans({ms: ms|trans({ms: stats.avgMs}, 'admin')}, 'admin') : null, 'grey') }}
    </div>

    {{ ui.tabs([
        {key: 'all', label: 'journal.ai.filterAll'|trans({}, 'admin')},
        {key: 'proposed', label: 'ai.status.proposed'|trans({}, 'admin')},
        {key: 'applied', label: 'ai.status.applied'|trans({}, 'admin')},
        {key: 'settled', label: 'journal.ai.filterSettled'|trans({}, 'admin')},
        {key: 'reverted', label: 'ai.status.reverted'|trans({}, 'admin')},
        {key: 'failed', label: 'ai.status.failed'|trans({}, 'admin')},
    ], filter, 'admin_ai_log') }}

    <section class="{{ ui.card_class() }}" aria-label="{{ 'journal.ai.listAria'|trans({}, 'admin') }}">
        {% if rows is empty %}
            <p class="text-body text-muted">{{ 'journal.ai.empty'|trans({}, 'admin') }}</p>
        {% else %}
            <div class="overflow-x-auto">
                <table class="w-full min-w-[900px] text-left">
                    <thead><tr class="text-legend font-bold text-muted">
                        <th scope="col" class="pb-3">{{ 'journal.ai.thWhen'|trans({}, 'admin') }}</th>
                        <th scope="col" class="pb-3">{{ 'journal.ai.thCase'|trans({}, 'admin') }}</th>
                        <th scope="col" class="pb-3">{{ 'journal.ai.thVerdict'|trans({}, 'admin') }}</th>
                        <th scope="col" class="pb-3 text-right">{{ 'journal.ai.thConfidence'|trans({}, 'admin') }}</th>
                        <th scope="col" class="pb-3">{{ 'journal.ai.thStatus'|trans({}, 'admin') }}</th>
                        <th scope="col" class="pb-3">{{ 'journal.ai.thModel'|trans({}, 'admin') }}</th>
                        <th scope="col" class="pb-3"><span class="sr-only">{{ 'journal.scans.thDetail'|trans({}, 'admin') }}</span></th>
                    </tr></thead>
                    <tbody>
                    {% for review in rows %}
                        {% set st = statusPills[review.status.value] %}
                        <tr class="border-t border-ink/8 align-top text-legend">
                            <td class="py-3">{{ review.createdAt|admin_date(true) }}<br><span class="text-muted">{{ review.requestedBy ? review.requestedBy.email : 'journal.ai.byPipeline'|trans({}, 'admin') }}</span></td>
                            <td class="py-3">
                                {% if review.report %}<a class="font-bold hover:underline" href="{{ path('admin_report', {id: review.report.id}) }}">{{ 'journal.ai.caseReport'|trans({id: review.report.id|slice(-6)}, 'admin') }}</a>
                                {% elseif review.dispute %}<a class="font-bold hover:underline" href="{{ path('admin_dispute', {id: review.dispute.id}) }}">{{ 'journal.ai.caseDispute'|trans({reference: review.dispute.order.reference}, 'admin') }}</a>{% endif %}
                                {% if review.summary %}<br><span class="text-muted">{{ review.summary|length > 110 ? review.summary|slice(0, 110) ~ "…" : review.summary }}</span>{% endif %}
                            </td>
                            <td class="py-3 font-bold">{{ review.verdict ? (verdicts[review.verdict] ?? review.verdict) : '—' }}</td>
                            <td class="py-3 text-right font-bold {{ review.confidence is not null and review.confidence >= threshold ? 'text-main' }}">{{ review.confidence is not null ? review.confidence ~ ' %' : '—' }}</td>
                            <td class="py-3">{{ ui.pill(st[0], st[1]) }}</td>
                            <td class="py-3">{{ review.model ?? '—' }}<br><span class="text-muted">{{ ms|trans({ms: review.durationMs}, 'admin') }}</span></td>
                            <td class="py-3 text-right"><a class="font-bold text-primary hover:underline" href="{{ path('admin_ai_review', {id: review.id}) }}">{{ 'journal.view'|trans({}, 'admin') }} ›</a></td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {{ ui.pager(page, perPage, total, 'admin_ai_log', {filter: filter}) }}
        {% endif %}
    </section>
{% endblock %}
