{% extends 'admin/base.html.twig' %}
{% import 'admin/_ui.html.twig' as ui %}

{% block title %}Litiges et remboursements{% endblock %}
{% block active %}disputes{% endblock %}
{% block heading %}Litiges et remboursements{% endblock %}
{% block subtitle %}{{ openCount }} litige{{ openCount > 1 ? 's' }} ouvert{{ openCount > 1 ? 's' }} · {{ refundCount }} remboursement{{ refundCount > 1 ? 's' }}{% endblock %}
{% block search %}{{ ui.search('N° de commande…', query, {filter: tab}) }}{% endblock %}

{% block body %}
    {% set reasons = {NOT_RECEIVED: 'Colis jamais reçu', NOT_AS_DESCRIBED: 'Non conforme à l’annonce', DAMAGED: 'Endommagé à la réception', PAYMENT_ISSUE: 'Problème de paiement', OTHER: 'Autre'} %}

    {# Deux onglets, un seul actif (rail gris, onglet plein), comme la maquette. #}
    <nav aria-label="Litiges ou remboursements" class="mb-6 flex rounded-full bg-ink/[0.05] p-1">
        {% for key, label in {disputes: 'Litiges (' ~ openCount ~ ')', refunds: 'Remboursements (' ~ refundCount ~ ')'} %}
            <a href="{{ path('admin_disputes', {filter: key, q: query}) }}" {% if key == tab %}aria-current="page"{% endif %}
               class="flex h-10 flex-1 items-center justify-center rounded-full text-legend font-bold {{ key == tab ? 'bg-surface text-ink shadow-[0_1px_3px_rgba(26,30,36,0.12)]' : 'text-muted hover:text-ink' }}">{{ label }}</a>
        {% endfor %}
    </nav>

    <section class="{{ ui.card_class() }}" aria-label="{{ tab == 'refunds' ? 'Remboursements' : 'Litiges' }}">
        {% if rows is empty %}
            <p class="text-body text-muted">{{ tab == 'refunds' ? 'Aucun remboursement.' : 'Aucun litige : une vente qui se passe bien entre amis n’en a jamais.' }}</p>
        {% elseif tab == 'refunds' %}
            <div class="overflow-x-auto">
                <table class="w-full min-w-[720px] text-left">
                    <thead><tr class="text-legend font-bold text-muted">
                        <th scope="col" class="pb-3">Commande</th><th scope="col" class="pb-3">Motif</th><th scope="col" class="pb-3">Demandé par</th>
                        <th scope="col" class="pb-3">Montant</th><th scope="col" class="pb-3">Le</th><th scope="col" class="pb-3">Statut</th>
                    </tr></thead>
                    <tbody>
                    {% set refundStatus = {REQUESTED: ['Demandé', 'pink'], PROCESSING: ['En cours', 'pink'], SUCCEEDED: ['Remboursé', 'green'], FAILED: ['Échoué', 'red']} %}
                    {% for refund in rows %}
                        {% set st = refundStatus[refund.status.value] ?? [refund.status.value, 'grey'] %}
                        <tr class="border-t border-ink/8 text-legend">
                            <td class="py-3 text-body font-bold">#{{ refund.order.reference }}</td>
                            <td class="py-3">{{ refund.reason }}</td>
                            <td class="py-3">{{ refund.requestedBy.displayName }}</td>
                            <td class="py-3">{{ refund.amount|admin_euros }} €</td>
                            <td class="py-3">{{ refund.createdAt|admin_date }}</td>
                            <td class="py-3">{{ ui.pill(st[0], st[1]) }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {{ ui.pager(page, perPage, total, 'admin_disputes', {filter: tab, q: query}, 'exécutés par le prestataire de paiement') }}
        {% else %}
            <div class="overflow-x-auto">
                <table class="w-full min-w-[820px] text-left">
                    <thead><tr class="text-legend font-bold text-muted">
                        <th scope="col" class="pb-3">Commande</th><th scope="col" class="pb-3">Motif</th><th scope="col" class="pb-3">Acheteur</th>
                        <th scope="col" class="pb-3">Vendeur</th><th scope="col" class="pb-3">Montant</th><th scope="col" class="pb-3">Ouvert le</th>
                        <th scope="col" class="pb-3">Statut</th><th scope="col" class="pb-3"><span class="sr-only">Détail</span></th>
                    </tr></thead>
                    <tbody>
                    {% set disputeStatus = {OPEN: ['Décision attendue', 'red'], UNDER_REVIEW: ['Pris en charge', 'pink'], RESOLVED: ['Résolu', 'green'], CLOSED: ['Clos', 'grey']} %}
                    {% for dispute in rows %}
                        {% set st = disputeStatus[dispute.status.value] %}
                        <tr class="border-t border-ink/8 text-legend">
                            <td class="py-3 text-body font-bold">#{{ dispute.order.reference }}</td>
                            <td class="py-3">{{ reasons[dispute.reason.value] }}</td>
                            <td class="py-3">{{ dispute.order.buyer.displayName }}</td>
                            <td class="py-3">{{ dispute.order.seller.displayName }}</td>
                            <td class="py-3">{{ dispute.order.totalAmount|admin_euros }} €</td>
                            <td class="py-3">{{ dispute.createdAt|admin_date }}</td>
                            <td class="py-3">{{ ui.pill(st[0], st[1]) }}</td>
                            <td class="py-3 text-right"><a class="font-bold text-primary hover:underline" href="{{ path('admin_dispute', {id: dispute.id}) }}">Voir<span class="sr-only"> le litige #{{ dispute.order.reference }}</span> ›</a></td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {{ ui.pager(page, perPage, total, 'admin_disputes', {filter: tab, q: query}, 'un litige qui se règle entre amis se clôt sans intervention') }}
        {% endif %}
    </section>
{% endblock %}
