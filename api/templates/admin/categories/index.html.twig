{% extends 'admin/base.html.twig' %}
{% import 'admin/_ui.html.twig' as ui %}

{% block title %}{{ 'categories.title'|trans({}, 'admin') }}{% endblock %}
{% block active %}categories{% endblock %}
{% block heading %}{{ 'categories.title'|trans({}, 'admin') }}{% endblock %}
{% block subtitle %}{{ 'categories.subtitle'|trans({}, 'admin') }}{% endblock %}

{% block body %}
    {% set super = is_granted('ROLE_SUPER_ADMIN') %}
    {% set field = 'h-10 rounded-sm bg-bg px-3 text-legend outline-none focus:ring-2 focus:ring-primary' %}

    {# Renommer ou supprimer une catégorie (super administrateur), replié par défaut. #}
    {% macro edit(category, kind, field) %}
        <details class="text-legend">
            <summary class="cursor-pointer font-bold text-primary">{{ 'categories.editNamed'|trans({name: category.name}, 'admin') }}</summary>
            <div class="mt-2 flex flex-wrap items-center gap-2">
                <form method="post" action="{{ path('admin_category_rename', {kind: kind, id: category.id}) }}" class="flex gap-2">
                    <input type="hidden" name="_token" value="{{ csrf_token('category-' ~ category.id) }}">
                    <label class="sr-only" for="nom-{{ category.id }}">{{ 'categories.newName'|trans({}, 'admin') }}</label>
                    <input id="nom-{{ category.id }}" name="name" value="{{ category.name }}" required maxlength="80" class="{{ field }}">
                    <button class="rounded-sm bg-surface px-3 font-bold shadow-[0_1px_3px_rgba(26,30,36,0.12)]">{{ 'categories.rename'|trans({}, 'admin') }}</button>
                </form>
                <form method="post" action="{{ path('admin_category_delete', {kind: kind, id: category.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('category-' ~ category.id) }}">
                    <button class="px-2 font-bold text-error hover:underline">{{ 'categories.delete'|trans({}, 'admin') }}</button>
                </form>
            </div>
        </details>
    {% endmacro %}

    {% macro list(title, rows, kind, countKey, super, field) %}
        <section class="rounded-md bg-surface p-6 shadow-[0_1px_3px_rgba(26,30,36,0.08)]" aria-label="{{ title }}">
            <h2 class="text-legend font-bold text-muted">{{ title }}</h2>
            <ul class="mt-3 flex flex-col gap-2">
                {% for row in rows %}
                    <li class="rounded-sm bg-ink/[0.03] px-4 py-3">
                        <p class="text-body font-bold">{{ row.category.name }}</p>
                        <p class="text-legend text-muted">{{ countKey|trans({count: row.possessions, children: row.children|length}, 'admin') }}</p>
                        {% if row.children is not empty %}
                            <p class="mt-2 flex flex-wrap gap-1">
                                {% for child in row.children %}
                                    <span class="rounded-full bg-surface px-2 py-0.5 text-legend shadow-[0_1px_2px_rgba(26,30,36,0.08)]">{{ child.category.name }} · {{ child.possessions }}</span>
                                {% endfor %}
                            </p>
                        {% endif %}
                        {% if super %}
                            <div class="mt-2 flex flex-col gap-1">
                                {{ _self.edit(row.category, kind, field) }}
                                {% for child in row.children %}
                                    <div class="pl-3">{{ _self.edit(child.category, kind, field) }}</div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </li>
                {% else %}
                    <li class="text-legend text-muted">{{ 'categories.list.empty'|trans({}, 'admin') }}</li>
                {% endfor %}
            </ul>
        </section>
    {% endmacro %}

    {{ include('admin/categories/_tabs.html.twig') }}

    {% if super %}
        {# Ajouter une catégorie : principale, ou sous une catégorie principale. #}
        <section class="{{ ui.card_class() }} mb-6" aria-labelledby="ajouter-categorie">
            <h2 id="ajouter-categorie" class="text-legend font-bold text-muted">{{ 'categories.add.title'|trans({}, 'admin') }}</h2>
            <form method="post" action="{{ path('admin_category_add') }}" class="mt-3 flex flex-wrap items-end gap-3 text-legend">
                <input type="hidden" name="_token" value="{{ csrf_token('category-add') }}">
                <label class="flex flex-col gap-1">
                    <span class="font-bold text-muted">{{ 'categories.add.kind'|trans({}, 'admin') }}</span>
                    <select name="kind" class="{{ field }}">
                        <option value="garment">{{ 'categories.list.garmentsTitle'|trans({}, 'admin') }}</option>
                        <option value="item">{{ 'categories.list.itemsTitle'|trans({}, 'admin') }}</option>
                    </select>
                </label>
                <label class="flex flex-col gap-1">
                    <span class="font-bold text-muted">{{ 'categories.add.name'|trans({}, 'admin') }}</span>
                    <input name="name" required maxlength="80" class="{{ field }} w-56">
                </label>
                <label class="flex flex-col gap-1">
                    <span class="font-bold text-muted">{{ 'categories.add.parent'|trans({}, 'admin') }}</span>
                    <select name="parent" class="{{ field }} max-w-[260px]">
                        <option value="">{{ 'categories.add.root'|trans({}, 'admin') }}</option>
                        <optgroup label="{{ 'categories.list.garmentsTitle'|trans({}, 'admin') }}">
                            {% for row in garments %}<option value="{{ row.category.id }}">{{ row.category.name }}</option>{% endfor %}
                        </optgroup>
                        <optgroup label="{{ 'categories.list.itemsTitle'|trans({}, 'admin') }}">
                            {% for row in items %}<option value="{{ row.category.id }}">{{ row.category.name }}</option>{% endfor %}
                        </optgroup>
                    </select>
                </label>
                <label class="flex flex-col gap-1">
                    <span class="font-bold text-muted">{{ 'categories.add.warmth'|trans({}, 'admin') }}</span>
                    <select name="warmth" class="{{ field }}">
                        <option value="">—</option>
                        {% for w in ['VERY_LIGHT', 'LIGHT', 'MID', 'WARM', 'VERY_WARM'] %}<option value="{{ w }}">{{ ('categories.warmth.' ~ w)|trans({}, 'admin') }}</option>{% endfor %}
                    </select>
                </label>
                <label class="flex flex-col gap-1">
                    <span class="font-bold text-muted">{{ 'categories.add.sizes'|trans({}, 'admin') }}</span>
                    <select name="sizeSystem" class="{{ field }}">
                        <option value="">—</option>
                        {% for s in sizeSystems %}<option value="{{ s.id }}">{{ s.name }}</option>{% endfor %}
                    </select>
                </label>
                <button class="h-10 rounded-md bg-primary px-4 font-bold text-white hover:brightness-110">{{ 'categories.add.submit'|trans({}, 'admin') }}</button>
            </form>
            <p class="mt-2 text-legend text-muted">{{ 'categories.add.help'|trans({}, 'admin') }}</p>
        </section>
    {% endif %}

    <div class="grid gap-6 lg:grid-cols-2 xl:grid-cols-[1fr_1fr_minmax(0,320px)]">
        {{ _self.list('categories.list.itemsTitle'|trans({}, 'admin'), items, 'item', 'categories.list.itemsCount', super, field) }}
        {{ _self.list('categories.list.garmentsTitle'|trans({}, 'admin'), garments, 'garment', 'categories.list.garmentsCount', super, field) }}

        <div class="flex flex-col gap-6">
            <section class="{{ ui.card_class() }}" aria-labelledby="styles">
                <h2 id="styles" class="text-legend font-bold text-muted">{{ 'categories.styles.title'|trans({}, 'admin') }}</h2>
                <ul class="mt-3 flex flex-col gap-2">
                    {% for row in styles %}
                        <li class="flex justify-between gap-3 rounded-sm bg-ink/[0.03] px-4 py-3 text-legend">
                            <span class="text-body font-bold">{{ row.style.name }}</span>
                            <span class="text-muted">{{ 'categories.styles.count'|trans({count: row.n}, 'admin') }}</span>
                        </li>
                    {% else %}
                        <li class="text-legend text-muted">{{ 'categories.styles.empty'|trans({}, 'admin') }}</li>
                    {% endfor %}
                </ul>
            </section>

            <section class="{{ ui.card_class() }}" aria-labelledby="etats">
                <h2 id="etats" class="text-legend font-bold text-muted">{{ 'categories.states.title'|trans({}, 'admin') }}</h2>
                <p class="mt-3 flex flex-wrap gap-2">
                    {{ ui.pill('categories.states.available'|trans({}, 'admin'), 'green') }} {{ ui.pill('categories.states.lentOut'|trans({}, 'admin'), 'pink') }} {{ ui.pill('categories.states.borrowed'|trans({}, 'admin'), 'pink') }}
                    {{ ui.pill('categories.states.lost'|trans({}, 'admin'), 'red') }} {{ ui.pill('categories.states.sold'|trans({}, 'admin'), 'grey') }} {{ ui.pill('categories.states.onSale'|trans({}, 'admin'), 'pink') }}
                </p>
                <p class="mt-3 text-legend text-muted">{{ 'categories.states.note'|trans({}, 'admin') }}</p>
            </section>
        </div>
    </div>

    <p class="mt-6 text-legend text-muted">{{ 'categories.footer'|trans({}, 'admin')|raw }}</p>
{% endblock %}
