{% extends 'admin/base.html.twig' %}
{% import 'admin/_ui.html.twig' as ui %}

{% block title %}{{ 'sales.pageTitle'|trans({}, 'admin') }}{% endblock %}
{% block active %}sales{% endblock %}
{% block heading %}{{ 'sales.heading'|trans({}, 'admin') }}{% endblock %}
{% block subtitle %}{{ 'sales.subtitle'|trans({month: month}, 'admin') }}{% endblock %}
{% block search %}{{ ui.search('sales.searchPlaceholder'|trans({}, 'admin'), query, {filter: filter}) }}{% endblock %}

{% block body %}
    {% set shipments = {SHIPPED: 'sales.shipment.shipped'|trans({}, 'admin'), IN_TRANSIT: 'sales.shipment.inTransit'|trans({}, 'admin'), DELIVERED: 'sales.shipment.delivered'|trans({}, 'admin'), RETURNED: 'sales.shipment.returned'|trans({}, 'admin'), LOST: 'sales.shipment.lost'|trans({}, 'admin')} %}

    <div class="mb-6 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
        {{ ui.kpi('sales.kpi.monthSales'|trans({}, 'admin'), stats.count|number_format(0, ',', ' '), null, 'grey') }}
        {{ ui.kpi('sales.kpi.volume'|trans({}, 'admin'), stats.volume|admin_euros ~ ' €', null, 'grey') }}
        {{ ui.kpi('sales.kpi.successfulPayments'|trans({}, 'admin'), stats.paymentRate is null ? '—' : stats.paymentRate|number_format(1, ',', ' ') ~ ' %', 'sales.kpi.failedPayments'|trans({count: stats.paymentsFailed}, 'admin'), stats.paymentsFailed > 0 ? 'red' : 'grey') }}
        {{ ui.kpi('sales.kpi.refunded'|trans({}, 'admin'), stats.refunds, 'sales.kpi.viaProvider'|trans({}, 'admin'), 'grey') }}
    </div>

    {{ ui.tabs([
        {key: 'all', label: 'sales.tabs.all'|trans({}, 'admin')},
        {key: 'paid', label: 'sales.tabs.paid'|trans({}, 'admin')},
        {key: 'shipping', label: 'sales.tabs.shipping'|trans({}, 'admin')},
        {key: 'refunded', label: 'sales.tabs.refunded'|trans({}, 'admin')},
        {key: 'disputed', label: 'sales.tabs.disputed'|trans({}, 'admin')},
    ], filter, 'admin_sales', {q: query}) }}

    <section class="{{ ui.card_class() }}" aria-label="{{ 'sales.aria.orders'|trans({}, 'admin') }}">
        {% if rows is empty %}
            <p class="text-body text-muted">{{ query ? 'sales.empty.search'|trans({query: query}, 'admin') : 'sales.empty.none'|trans({}, 'admin') }}</p>
        {% else %}
            <div class="overflow-x-auto">
                <table class="w-full min-w-[820px] text-left">
                    <thead>
                    <tr class="text-legend font-bold text-muted">
                        <th scope="col" class="pb-3">{{ 'sales.table.order'|trans({}, 'admin') }}</th>
                        <th scope="col" class="pb-3">{{ 'sales.table.item'|trans({}, 'admin') }}</th>
                        <th scope="col" class="pb-3">{{ 'sales.table.sellerBuyer'|trans({}, 'admin') }}</th>
                        <th scope="col" class="pb-3">{{ 'sales.table.amount'|trans({}, 'admin') }}</th>
                        <th scope="col" class="pb-3">{{ 'sales.table.status'|trans({}, 'admin') }}</th>
                        <th scope="col" class="pb-3">{{ 'sales.table.delivery'|trans({}, 'admin') }}</th>
                        <th scope="col" class="pb-3">{{ 'sales.table.date'|trans({}, 'admin') }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for order in rows %}
                        <tr class="border-t border-ink/8 text-legend">
                            <td class="py-3 text-body font-bold">
                                {% if order.dispute %}<a class="hover:underline" href="{{ path('admin_dispute', {id: order.dispute.id}) }}">#{{ order.reference }}</a>{% else %}#{{ order.reference }}{% endif %}
                            </td>
                            <td class="py-3">{{ order.listing.possession.name }}</td>
                            <td class="py-3">{{ order.seller.displayName }} → {{ order.buyer.displayName }}</td>
                            <td class="py-3">{{ order.totalAmount|admin_euros }} €</td>
                            <td class="py-3">{{ ui.order_status(order.status) }}{% if order.dispute and order.dispute.status.value in ['OPEN', 'UNDER_REVIEW'] %} {{ ui.pill('sales.status.disputed'|trans({}, 'admin'), 'pink') }}{% endif %}</td>
                            <td class="py-3">
                                {% if order.deliveryMethod.value == 'HANDOVER' %}
                                    {{ 'sales.delivery.handover'|trans({}, 'admin') }} · {{ order.status.value == 'COMPLETED' ? 'sales.delivery.handedOver'|trans({}, 'admin') : 'sales.delivery.toHandOver'|trans({}, 'admin') }}
                                {% elseif order.shipment %}
                                    {{ order.shipment.carrier }} · {{ shipments[order.shipment.status.value] ?? order.shipment.status.value }}
                                {% else %}—{% endif %}
                            </td>
                            <td class="py-3">{{ order.createdAt|admin_date }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {{ ui.pager(page, perPage, total, 'admin_sales', {filter: filter, q: query}, 'sales.pagerNotice'|trans({}, 'admin')) }}
        {% endif %}
    </section>
{% endblock %}
