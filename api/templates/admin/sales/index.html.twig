{% extends 'admin/base.html.twig' %}
{% import 'admin/_ui.html.twig' as ui %}

{% block title %}Ventes et transactions{% endblock %}
{% block active %}sales{% endblock %}
{% block heading %}Ventes et transactions{% endblock %}
{% block subtitle %}{{ month }} · paiements traités par le prestataire{% endblock %}
{% block search %}{{ ui.search('N° de commande…', query, {filter: filter}) }}{% endblock %}

{% block body %}
    {% set shipments = {SHIPPED: 'expédié', IN_TRANSIT: 'en transit', DELIVERED: 'livré', RETURNED: 'retourné', LOST: 'perdu'} %}

    <div class="mb-6 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
        {{ ui.kpi('Ventes du mois', stats.count|number_format(0, ',', ' '), null, 'grey') }}
        {{ ui.kpi('Volume', stats.volume|admin_euros ~ ' €', null, 'grey') }}
        {{ ui.kpi('Paiements réussis', stats.paymentRate is null ? '—' : stats.paymentRate|number_format(1, ',', ' ') ~ ' %', stats.paymentsFailed ~ (stats.paymentsFailed > 1 ? ' refusés' : ' refusé'), stats.paymentsFailed > 0 ? 'red' : 'grey') }}
        {{ ui.kpi('Remboursés', stats.refunds, 'via le prestataire', 'grey') }}
    </div>

    {{ ui.tabs([
        {key: 'all', label: 'Toutes'},
        {key: 'paid', label: 'Payées'},
        {key: 'shipping', label: 'En livraison'},
        {key: 'refunded', label: 'Remboursées'},
        {key: 'disputed', label: 'En litige'},
    ], filter, 'admin_sales', {q: query}) }}

    <section class="{{ ui.card_class() }}" aria-label="Commandes">
        {% if rows is empty %}
            <p class="text-body text-muted">{{ query ? 'Aucune commande ne correspond à « ' ~ query ~ ' ».' : 'Aucune commande ici.' }}</p>
        {% else %}
            <div class="overflow-x-auto">
                <table class="w-full min-w-[820px] text-left">
                    <thead>
                    <tr class="text-legend font-bold text-muted">
                        <th scope="col" class="pb-3">Commande</th>
                        <th scope="col" class="pb-3">Article</th>
                        <th scope="col" class="pb-3">Vendeur → Acheteur</th>
                        <th scope="col" class="pb-3">Montant</th>
                        <th scope="col" class="pb-3">Statut</th>
                        <th scope="col" class="pb-3">Livraison</th>
                        <th scope="col" class="pb-3">Date</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for order in rows %}
                        <tr class="border-t border-ink/8 text-legend">
                            <td class="py-3 text-body font-bold">
                                {% if order.dispute %}<a class="hover:underline" href="{{ path('admin_dispute', {id: order.dispute.id}) }}">#{{ order.reference }}</a>{% else %}#{{ order.reference }}{% endif %}
                            </td>
                            <td class="py-3">{{ order.listing.possession.name }}</td>
                            <td class="py-3">{{ order.seller.displayName }} → {{ order.buyer.displayName }}</td>
                            <td class="py-3">{{ order.totalAmount|admin_euros }} €</td>
                            <td class="py-3">{{ ui.order_status(order.status) }}{% if order.dispute and order.dispute.status.value in ['OPEN', 'UNDER_REVIEW'] %} {{ ui.pill('En litige', 'pink') }}{% endif %}</td>
                            <td class="py-3">
                                {% if order.deliveryMethod.value == 'HANDOVER' %}
                                    Main propre · {{ order.status.value == 'COMPLETED' ? 'remis' : 'à remettre' }}
                                {% elseif order.shipment %}
                                    {{ order.shipment.carrier }} · {{ shipments[order.shipment.status.value] ?? order.shipment.status.value }}
                                {% else %}—{% endif %}
                            </td>
                            <td class="py-3">{{ order.createdAt|admin_date }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {{ ui.pager(page, perPage, total, 'admin_sales', {filter: filter, q: query}, 'l’administration consulte, elle ne manipule jamais d’argent') }}
        {% endif %}
    </section>
{% endblock %}
