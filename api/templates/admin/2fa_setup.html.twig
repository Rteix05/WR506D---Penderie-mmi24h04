{#
 # Activer la double authentification (première connexion d'un
 # administrateur) : scanner le QR code avec une application
 # d'authentification, puis confirmer avec un premier code.
 #}
<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ 'twofa.setup.pageTitle'|trans({}, 'admin') }}</title>
    {{ importmap('app') }}
</head>
<body class="grid min-h-screen place-items-center bg-ink px-5 py-10">
<main class="w-full max-w-md rounded-lg bg-surface p-8">
    <p class="flex items-center gap-2 font-typolio text-[20px]">PENDERIE <span class="rounded-full bg-primary px-2 py-0.5 font-luciole text-legend font-bold text-white">ADMIN</span></p>
    <h1 class="mt-6 font-typolio text-h4 uppercase">{{ 'twofa.setup.title'|trans({}, 'admin') }}</h1>
    <p class="mt-1 text-legend text-muted">{{ 'twofa.setup.legend'|trans({}, 'admin') }}</p>

    <ol class="mt-6 flex flex-col gap-4 text-legend">
        <li>
            <span class="text-body font-bold">{{ 'twofa.setup.step1Title'|trans({}, 'admin') }}</span><br>
            <span class="text-muted">{{ 'twofa.setup.step1Hint'|trans({}, 'admin') }}</span>
            <img src="{{ qr }}" alt="{{ 'twofa.setup.qrAlt'|trans({}, 'admin') }}" width="220" height="220" class="mx-auto mt-3 rounded-sm bg-white p-2">
            <span class="mt-2 block text-center text-muted">{{ 'twofa.setup.manualKey'|trans({}, 'admin') }} <code class="font-bold tracking-wider text-ink">{{ secret }}</code></span>
        </li>
        <li>
            <span class="text-body font-bold">{{ 'twofa.setup.step2Title'|trans({}, 'admin') }}</span>
            {% if error %}<p role="alert" class="mt-2 rounded-sm bg-error/10 px-4 py-3 font-bold text-error">{{ error|trans({}, 'admin_flash') }}</p>{% endif %}
            <form method="post" class="mt-3 flex flex-col gap-3">
                <label class="flex flex-col gap-1">
                    <span class="sr-only">{{ 'twofa.code'|trans({}, 'admin') }}</span>
                    <input type="text" name="code" required autocomplete="one-time-code" inputmode="numeric" pattern="[0-9 ]{6,7}" maxlength="7" placeholder="123 456"
                           class="h-12 rounded-sm bg-surface px-4 text-body tracking-[0.3em] shadow-[0_1px_3px_rgba(26,30,36,0.12)] outline-none focus:ring-2 focus:ring-primary">
                </label>
                <input type="hidden" name="_token" value="{{ csrf_token('admin-2fa-setup') }}">
                <button type="submit" class="h-12 rounded-md bg-primary text-body font-bold text-white hover:brightness-110 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2">{{ 'twofa.setup.submit'|trans({}, 'admin') }}</button>
            </form>
        </li>
    </ol>

    <p class="mt-6 text-center text-legend"><a class="font-bold text-primary hover:underline" href="{{ path('admin_logout') }}">{{ 'twofa.logout'|trans({}, 'admin') }}</a></p>
</main>
</body>
</html>
