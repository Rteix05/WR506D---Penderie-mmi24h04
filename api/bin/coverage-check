#!/usr/bin/env php
<?php

/*
 * Contrôle de la couverture du code MÉTIER (docs/coverage.md, séance 16).
 *
 *     php bin/coverage-check var/coverage/clover.xml
 *
 * Lit le rapport Clover de PHPUnit et exige 100 % des lignes :
 *
 *  - des dossiers où vivent les règles : Service, Security, Validator,
 *    State, Doctrine, Serializer, Enum, Util ;
 *  - des méthodes des entités qui prennent une décision (complexité
 *    cyclomatique ≥ 2 : un if, un match, une exception). Un accesseur
 *    sans branche (getName, setNotes) n'est pas une règle : il est mesuré
 *    dans le total, pas exigé.
 *
 * Hors périmètre (mesuré, affiché, pas exigé) : Controller (la couche HTTP,
 * testée par les tests fonctionnels), Repository (générés), ReferenceData
 * (des listes de valeurs), Command, EventSubscriber, Kernel, DataFixtures.
 *
 * Code de sortie 1 si une ligne du périmètre n'est pas couverte, avec la
 * liste des lignes en cause.
 */

const RULE_DIRS = ['Service', 'Security', 'Validator', 'State', 'Doctrine', 'Serializer', 'Enum', 'Util'];
const MIN_COMPLEXITY = 2;

$file = $argv[1] ?? 'var/coverage/clover.xml';
$clover = @simplexml_load_file($file);
if (false === $clover) {
    fwrite(\STDERR, "Rapport introuvable : $file (lancer d'abord make coverage).\n");
    exit(2);
}

/** @var array<string, array{0: int, 1: int}> $byDir lignes couvertes et totales, par dossier de src/ */
$byDir = [];
/** @var list<string> $missed */
$missed = [];
$scope = [0, 0];

foreach ($clover->xpath('//file') ?: [] as $f) {
    $path = (string) $f['name'];
    $relative = substr($path, (int) strpos($path, '/src/') + 5);
    $dir = explode('/', $relative)[0];
    $inRuleDir = in_array($dir, RULE_DIRS, true);
    $method = null;
    $complexity = 0;

    foreach ($f->line as $line) {
        if ('method' === (string) $line['type']) {
            $method = (string) $line['name'];
            $complexity = (int) $line['complexity'];
            continue;
        }
        if ('stmt' !== (string) $line['type']) {
            continue;
        }
        $covered = (int) $line['count'] > 0;
        $byDir[$dir][0] = ($byDir[$dir][0] ?? 0) + (int) $covered;
        $byDir[$dir][1] = ($byDir[$dir][1] ?? 0) + 1;

        $inScope = $inRuleDir || ('Entity' === $dir && $complexity >= MIN_COMPLEXITY);
        if (!$inScope) {
            continue;
        }
        ++$scope[1];
        if ($covered) {
            ++$scope[0];
        } else {
            $missed[] = sprintf('  src/%s:%d (%s)', $relative, (int) $line['num'], $method ?? '?');
        }
    }
}

ksort($byDir);
$total = [array_sum(array_column($byDir, 0)), array_sum(array_column($byDir, 1))];
$pct = static fn (array $c): string => sprintf('%6.2f %%', $c[1] > 0 ? 100 * $c[0] / $c[1] : 100);

echo "Couverture des lignes, par dossier de src/\n";
foreach ($byDir as $dir => $c) {
    $tag = in_array($dir, RULE_DIRS, true) ? 'métier' : ('Entity' === $dir ? 'règles' : '');
    printf("  %-16s %5d / %-5d %s  %s\n", $dir, $c[0], $c[1], $pct($c), $tag);
}
printf("  %-16s %5d / %-5d %s\n\n", 'TOTAL', $total[0], $total[1], $pct($total));
printf("Périmètre métier (dossiers « métier » + méthodes d'entités à décision) : %d / %d lignes, %s\n", $scope[0], $scope[1], trim($pct($scope)));

if ([] !== $missed) {
    echo "\nLignes métier non couvertes :\n".implode("\n", $missed)."\n";
    exit(1);
}
echo "OK : tout le code métier est exécuté par au moins un test.\n";
